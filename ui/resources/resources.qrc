<RCC>
    <qresource prefix="/fonts">
        <file alias="geist/thin.otf">fonts/Geist/Geist-Thin.otf</file>
        <file alias="geist/extralight.otf">fonts/Geist/Geist-ExtraLight.otf</file>
        <file alias="geist/light.otf">fonts/Geist/Geist-Light.otf</file>
        <file alias="geist/regular.otf">fonts/Geist/Geist-Regular.otf</file>
        <file alias="geist/medium.otf">fonts/Geist/Geist-Medium.otf</file>
        <file alias="geist/semibold.otf">fonts/Geist/Geist-SemiBold.otf</file>
        <file alias="geist/bold.otf">fonts/Geist/Geist-Bold.otf</file>
        <file alias="geist/extrabold.otf">fonts/Geist/Geist-ExtraBold.otf</file>
        <file alias="geist/black.otf">fonts/Geist/Geist-Black.otf</file>
        <file alias="geistmono/regular.otf">fonts/GeistMono/GeistMono-Regular.otf</file>
